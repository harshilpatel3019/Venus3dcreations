# --- Database (MongoDB Atlas free M0 tier works) ---
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=venus3d

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Admin user (seeded on first startup) ---
ADMIN_EMAIL=venus3dcreations@gmail.com
ADMIN_PASSWORD=

# --- Razorpay (test keys start with rzp_test_, live with rzp_live_) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email (Gmail app password; leave blank to skip sending) ---
GMAIL_USER=venus3dcreations@gmail.com
GMAIL_APP_PASSWORD=

# --- CORS: comma-separated allowed origins for the frontend ---
CORS_ORIGINS=https://venus3dcreations.com,https://www.venus3dcreations.com

# --- Shiprocket (leave blank to disable shipment creation) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Set to true to auto-create shipments when an order is paid
SHIPROCKET_AUTO_SHIP=false
SHIPROCKET_DEFAULT_WEIGHT_KG=1.0
SHIPROCKET_DEFAULT_LENGTH_CM=25
SHIPROCKET_DEFAULT_BREADTH_CM=25
SHIPROCKET_DEFAULT_HEIGHT_CM=35
